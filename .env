# CampusConnect Lab 7: API Gateway, Service Discovery & Cloud Configuration
GATEWAY_PORT=8080
PORT=8080

# Service Discovery URLs (Docker Network Service Names)
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003
SERVICE_TIMEOUT=5000

# Database Persistence (Local Docker or MongoDB Atlas Cloud)
MONGO_URI_USER=mongodb://mongodb:27017/user_db
MONGO_URI_PRODUCT=mongodb://mongodb:27017/product_db
MONGO_URI_ORDER=mongodb://mongodb:27017/order_db

# MongoDB Atlas Cloud Example (Uncomment to use Atlas directly):
# MONGO_URI_USER=mongodb+srv://campusadmin:SecretPass123@cluster0.mongodb.net/user_db?retryWrites=true&w=majority
# MONGO_URI_PRODUCT=mongodb+srv://campusadmin:SecretPass123@cluster0.mongodb.net/product_db?retryWrites=true&w=majority
# MONGO_URI_ORDER=mongodb+srv://campusadmin:SecretPass123@cluster0.mongodb.net/order_db?retryWrites=true&w=majority

NODE_ENV=production
